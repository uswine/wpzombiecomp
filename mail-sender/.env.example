# Copy to the server's environment (systemd EnvironmentFile, docker --env-file, etc.)
# NEVER commit the filled-in version.

ZC_MAIL_TENANT_ID=02f52ee9-e30b-4ec1-8276-c354af5494ae
ZC_MAIL_CLIENT_ID=<client id from the ZC Mail Sender app registration>
ZC_MAIL_CLIENT_SECRET=<client secret value — shown once at creation>
ZC_MAIL_FROM=ahall@zombiecomponents.com

# Caller API keys: comma-separated keyid:secret pairs.
# Callers send the whole "keyid:secret" string in the X-API-Key header.
ZC_MAIL_API_KEYS=claude-main:<generate with: openssl rand -hex 32>

ZC_MAIL_HOURLY_CAP=50
ZC_MAIL_RECIPIENT_CAP=20
ZC_MAIL_STATE_FILE=/var/lib/zc-mail-sender/state.json
ZC_MAIL_PORT=8321

# Set to 1 to also log full message bodies (off by default)
AUDIT_FULL=0
